{
  "name": "sac-flow",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "tsx watch server/index.ts",
    "dev:all": "concurrently -k -n WEB,API -c cyan,magenta \"npm:dev\" \"npm:dev:api\"",
    "check": "tsc --noEmit -p tsconfig.json && tsc -p tsconfig.server.json --noEmit",
    "build": "vite build && node scripts/prepare-sites-build.mjs",
    "build:api": "tsc -p tsconfig.server.json",
    "build:all": "npm run build && npm run build:api",
    "preview": "vite preview",
    "start": "node dist-api/index.js",
    "start:worker": "node dist-api/worker.js",
    "migrate": "node scripts/run-migrations.mjs",
    "postgres:audit-json": "tsx server/postgres-importer.ts --dry-run",
    "postgres:import-json": "tsx server/postgres-importer.ts --write",
    "postgres:import-json:allow-warnings": "tsx server/postgres-importer.ts --write --allow-warnings",
    "test:migrations": "node scripts/validate-postgres-migrations.mjs",
    "test:server": "vitest run tests/server",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "test:e2e": "playwright test",
    "smoke:postgres-outbox": "node scripts/smoke-reply-outbox.mjs",
    "smoke:metricool-contract": "npm run build:api && node scripts/smoke-metricool-contract.mjs",
    "test": "npm run test:server && npm run test:sites && npm run test:migrations",
    "security:audit": "node scripts/run-npm-command.mjs audit --audit-level=high",
    "security:sbom": "node scripts/run-npm-command.mjs sbom --sbom-format cyclonedx > dist/sbom.cdx.json",
    "verify": "npm run check && npm run build:all && npm test && npm run security:audit"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/static": "^10.1.3",
    "@fontsource-variable/inter": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@types/pg": "^8.21.0",
    "@vitejs/plugin-react": "5.0.4",
    "@xyflow/react": "^12.11.3",
    "exceljs": "^4.4.0",
    "fastify": "^5.11.3",
    "pg": "^8.23.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "vite": "6.4.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "concurrently": "^10.0.5",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "fast-uri": "3.1.5",
    "find-my-way": "9.7.0",
    "nanoid": "3.3.18",
    "postcss": "8.5.26",
    "exceljs": {
      "uuid": "11.1.1",
      "archiver": {
        "archiver-utils": {
          "glob": {
            "minimatch": {
              "brace-expansion": "1.1.18"
            }
          }
        },
        "readdir-glob": {
          "minimatch": {
            "brace-expansion": "2.1.4"
          }
        }
      }
    }
  }
}
