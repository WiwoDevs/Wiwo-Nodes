# SAC Flow local runtime. Copy this file to .env; never commit the populated file.
NODE_ENV=development
LOG_LEVEL=info
API_HOST=127.0.0.1
PORT=8787
# Host interface used by docker-compose.production.yml for its published API port.
SAC_FLOW_BIND_ADDRESS=127.0.0.1
SERVE_FRONTEND=false
FRONTEND_DIR=./dist/client
# Vite proxies /api to the Fastify port during local development.
VITE_API_BASE_URL=/api
VITE_APP_BASE_PATH=/
# Keep false outside explicit demos; when false, the UI surfaces API failures.

# Local MVP persistence. The directory is mounted by docker-compose.yml.
# Use json only for local/demo or explicitly approved temporary live tests.
SAC_FLOW_REPOSITORY=json
SAC_FLOW_DATA_FILE=./data/sac-flow.json
# Production target. Apply db/migrations first; Postgres mode requires URL and encryption key.
SAC_FLOW_POSTGRES_URL=
SAC_FLOW_POSTGRES_ENCRYPTION_KEY=
SAC_FLOW_POSTGRES_ORGANIZATION_SLUG=techlab-sac
SAC_FLOW_POSTGRES_ORGANIZATION_NAME=Techlab SAC
# Defaults true only for local demo/non-production. Keep false in staging/production.
SAC_FLOW_POSTGRES_SEED_DEMO=
# Leave empty/false in production; set true only for a controlled live bridge before PostgreSQL.
SAC_FLOW_ALLOW_JSON_IN_LIVE=

# Lightweight API protection for live/staging until Techlab replaces it with SSO/RBAC.
# In live mode the server requires an API key by default. Ignored when SAC_FLOW_AUTH_MODE=google
# or dev: the signed sign-in session replaces the shared site key for browser access.
SAC_FLOW_API_KEY=
SAC_FLOW_REQUIRE_API_KEY=false
# Comma-separated absolute origins. Empty means same-origin only in live/production.
SAC_FLOW_CORS_ORIGINS=
SAC_FLOW_SECURITY_HEADERS=
# Reject browser mutations from cross-site or non-allowlisted origins.
# Enabled by default in production or Metricool live mode.
SAC_FLOW_ENFORCE_ORIGIN_CHECK=
SAC_FLOW_RATE_LIMIT_ENABLED=
SAC_FLOW_RATE_LIMIT_WINDOW_MS=60000
SAC_FLOW_RATE_LIMIT_MAX=600
# Inicio de sesion. "local" mantiene el actor por defecto del entorno de desarrollo;
# "google" exige iniciar sesion con Google (OAuth 2.0) y estar en la allowlist; "dev" es solo
# para pruebas locales: correo y contrasena contra los usuarios ficticios de
# SAC_FLOW_DEV_AUTH_USERS_FILE (por defecto dev-users.example.json); se rechaza en produccion.
SAC_FLOW_AUTH_MODE=local
# Cliente OAuth "Aplicacion web" de Google Cloud. El secreto solo vive en el servidor.
# Registrar en Google Cloud la URI de redireccion exacta (por defecto en desarrollo:
# http://localhost:5173/api/auth/google/callback); en produccion es obligatoria.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
# Secreto HMAC de la cookie de sesion (32+ caracteres). Obligatorio en produccion; sin el,
# cada reinicio de la API cierra las sesiones.
SAC_FLOW_AUTH_SESSION_SECRET=
# Allowlist local { "users": [ { "email", "name", "permissions", "nodesRole", "nodesBrandIds" } ] }.
# Ver allowed-users.example.json. Va en data/ (ignorado por git) porque contiene correos reales.
SAC_FLOW_AUTH_ALLOWED_USERS_FILE=./data/allowed-users.json
# Allowlist definida en el backend (coma separada). ADMIN_EMAILS entra con rol admin;
# ALLOWED_EMAILS con SAC_FLOW_AUTH_DEFAULT_ROLE. Es la forma recomendada en contenedores.
SAC_FLOW_AUTH_ADMIN_EMAILS=
SAC_FLOW_AUTH_ALLOWED_EMAILS=
# Opcional: dominios cuyo correo verificado entra con SAC_FLOW_AUTH_DEFAULT_ROLE (coma separada).
SAC_FLOW_AUTH_ALLOWED_DOMAINS=
# A donde vuelve el navegador tras iniciar sesion (por defecto VITE_APP_BASE_PATH o /).
SAC_FLOW_AUTH_POST_LOGIN_REDIRECT=
SAC_FLOW_AUTH_COOKIE=wiwo_nodes_session
SAC_FLOW_AUTH_SESSION_TTL_MS=432000000
# Permisos de la allowlist que gobiernan el acceso.
SAC_FLOW_AUTH_REQUIRED_PERMISSION=sac
SAC_FLOW_AUTH_ADMIN_PERMISSION=admin
# Rol asignado a quien tiene el permiso requerido pero no es admin.
SAC_FLOW_AUTH_DEFAULT_ROLE=agent
SAC_FLOW_AUTH_TENANT_ID=wiwo

# Temporary gateway identity bridge until native SSO/RBAC is implemented.
# Only set TRUST/REQUIRE behind a gateway that strips inbound spoofed X-SAC-* headers.
SAC_FLOW_TRUST_ACTOR_HEADERS=false
SAC_FLOW_REQUIRE_ACTOR_CONTEXT=false
SAC_FLOW_DEFAULT_ROLE=admin
# Independent scheduler gate for importing fresh inbox data from Metricool.
# This only reads Metricool and writes local records; it does not enable replies or provider mutations.
SAC_FLOW_INBOX_SYNC_ENABLED=false
# Emergency kill switch: when true, all mode="send" replies are blocked but drafts still work.
# When enabled later, durable delivery records prevent blind retries and surface uncertain sends for reconciliation.
SAC_FLOW_DISABLE_OUTBOUND_SENDS=true
# Least-privilege exception for human-approved SAC replies. This does not enable
# auto-replies or other Metricool mutations; keep false until an explicit UAT.
SAC_FLOW_ENABLE_MANUAL_REPLIES=false
# General Automation Studio: keep both protections true throughout development and UAT.
# HTTP Request nodes fail closed while external nodes are disabled.
SAC_FLOW_DISABLE_EXTERNAL_NODES=true
# Any non-preview Metricool operation in a general workflow fails closed while this is true.
SAC_FLOW_DISABLE_METRICOOL_MUTATIONS=true
# Independent auto-reply rollout gate. "shadow" evaluates safe candidates but never dispatches them.
# Change to "live" only for a supervised UAT; both kill switches above must also be false.
SAC_FLOW_AUTO_REPLY_DISPATCH_MODE=shadow
# Soft saturation guard for durable pending auto-replies (1-2000).
SAC_FLOW_AUTO_REPLY_MAX_PENDING=1000
# Separate AES-256-GCM key for generic credentials/secret variables. Required in production.
SAC_FLOW_CREDENTIALS_ENCRYPTION_KEY=
# Durable scheduler/worker (production compose only; PostgreSQL is mandatory).
SAC_FLOW_INTERNAL_API_URL=http://api:8787
SAC_FLOW_WORKER_ID=
SAC_FLOW_WORKER_POLL_MS=2000
SAC_FLOW_WORKER_HEALTH_PORT=8788
SAC_FLOW_WORKER_STALE_LEASE_MS=600000
# Generated infrastructure secret; this is not supplied by Metricool.
SAC_FLOW_POSTGRES_PASSWORD=

# Metricool API (Advanced or Custom plan required).
# Obtain these values from the authorized Metricool account. Do not paste examples
# or production secrets into this tracked file.
METRICOOL_MODE=demo
METRICOOL_BASE_URL=https://app.metricool.com/api
METRICOOL_API_TOKEN=
METRICOOL_USER_ID=
# Verifique cual devuelve datos para su cuenta: el inbox responde 200 con lista vacia
# cuando el proveedor no corresponde. INSTAGRAM cuando la cuenta se conecto con
# credenciales de Instagram; INSTAGRAMBUSINESS cuando se conecto a traves de Facebook.
# El sync intenta el alternativo automaticamente si el primario no devuelve nada.
METRICOOL_INSTAGRAM_PROVIDER=INSTAGRAMBUSINESS
# Optional single-brand fallback. The 20 accounts can instead store their own IDs.
METRICOOL_BLOG_ID=
# Leave empty to allow fallback only in demo. Do not enable in production.
METRICOOL_ALLOW_FALLBACK_ACCOUNT=
# Optional JSON object: {"account-id":{"userId":"...","blogId":"...","instagramProvider":"INSTAGRAMBUSINESS"}}.
# Leave empty in demo; do not place real values in this tracked template.
METRICOOL_ACCOUNTS_JSON=
